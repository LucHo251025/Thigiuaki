rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "hothanhluc.251005@gmail.com";
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && request.resource.data.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.soluong is int
        && request.resource.data.image is string;
      allow delete: if isAdmin();
    }
  }
}
